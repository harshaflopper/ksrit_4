# Copy this file to .env.local and fill it in.

# Gemini (free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Any Gemini Flash model your key has free quota for. Check https://aistudio.google.com/rate-limit
GEMINI_MODEL=gemini-2.5-flash

# Supabase (Project Settings > API). Leave empty to store listings in .data/items.json instead.
SUPABASE_URL=
# Server-only key. Never prefix it with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
